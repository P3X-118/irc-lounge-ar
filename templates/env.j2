{#
See: https://github.com/thelounge/thelounge/blob/v0.10.0/.env.example
#}

# your domain, e.g https://example.com
APP_URL={{ thelounge_environment_variable_app_url }}
PORT={{ thelounge_container_http_port }}

# minimum of 32 characters. Generate one with: openssl rand -hex 32
APP_SECRET={{ thelounge_environment_variable_app_secret }}

JWT_TOKEN_EXPIRES_IN={{ thelounge_environment_variable_jwt_token_expires_in }}

DATABASE_URL={{ thelounge_environment_variable_database_url }}
REDIS_URL={{ thelounge_environment_variable_redis_url }}

# options: local | s3
STORAGE_DRIVER={{ thelounge_environment_variable_storage_driver }}

{% if thelounge_environment_variable_storage_driver == 's3' %}
# S3 driver config
AWS_S3_ACCESS_KEY_ID={{ thelounge_environment_variable_aws_s3_access_key_id }}
AWS_S3_SECRET_ACCESS_KEY={{ thelounge_environment_variable_aws_s3_secret_access_key }}
AWS_S3_REGION={{ thelounge_environment_variable_aws_s3_region }}
AWS_S3_BUCKET={{ thelounge_environment_variable_aws_s3_bucket }}
AWS_S3_ENDPOINT={{ thelounge_environment_variable_aws_s3_endpoint }}
AWS_S3_FORCE_PATH_STYLE={{ thelounge_environment_variable_aws_s3_force_path_style | to_json }}
{% endif %}

# default: 50mb
FILE_UPLOAD_SIZE_LIMIT={{ thelounge_environment_variable_file_upload_size_limit }}

{% if thelounge_mailer_enabled %}
# options: smtp | postmark
MAIL_DRIVER={{ thelounge_environment_variable_mail_driver }}
MAIL_FROM_ADDRESS={{ thelounge_environment_variable_mail_from_address }}
MAIL_FROM_NAME={{ thelounge_environment_variable_mail_from_name }}

{% if thelounge_environment_variable_mail_driver == "smtp" %}
# SMTP driver config
SMTP_HOST={{ thelounge_environment_variable_smtp_host }}
SMTP_PORT={{ thelounge_environment_variable_smtp_port }}
SMTP_USERNAME={{ thelounge_environment_variable_smtp_username }}
SMTP_PASSWORD={{ thelounge_environment_variable_smtp_password }}
SMTP_SECURE={{ thelounge_environment_variable_smtp_secure | to_json }}
SMTP_IGNORETLS={{ thelounge_environment_variable_smtp_ignoretls | to_json }}

{% elif thelounge_environment_variable_mail_driver == "postmark" %}
# Postmark driver config
POSTMARK_TOKEN={{ thelounge_environment_variable_postmark_token }}
{% endif %}
{% endif %}

# for custom drawio server
DRAWIO_URL={{ thelounge_environment_variable_drawio_url }}

DISABLE_TELEMETRY={{ thelounge_environment_variable_disable_telemetry | to_json }}

{{ thelounge_environment_variables_additional_variables }}
