[Unit]
Description=The Lounge ({{ thelounge_identifier }})
{% for service in thelounge_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in thelounge_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ thelounge_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ thelounge_identifier }} 2>/dev/null || true'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ thelounge_identifier }} \
      --log-driver=none \
      --user={{ thelounge_uid }}:{{ thelounge_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ thelounge_container_network }} \
      {% if thelounge_container_http_host_bind_port %}
      -p {{ thelounge_container_http_host_bind_port }}:{{ thelounge_container_http_port }} \
      {% endif %}
      --env-file={{ thelounge_base_path }}/env \
      --label-file={{ thelounge_base_path }}/labels \
      {% if thelounge_container_additional_volumes | length == 0 %}
      --mount type=bind,src={{ thelounge_data_path }},dst=/var/opt/thelounge \
      {% endif %}
      {% for volume in thelounge_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options else '' }} \
      {% endfor %}
      {% for arg in thelounge_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ thelounge_container_image_self_build_name if thelounge_container_image_self_build else thelounge_container_image }}

{% for network in thelounge_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ thelounge_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ thelounge_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ thelounge_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ thelounge_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ thelounge_identifier }}

[Install]
WantedBy=multi-user.target
