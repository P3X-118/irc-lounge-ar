{% if thelounge_container_labels_traefik_enabled %}
traefik.enable=true

{% if thelounge_container_labels_traefik_docker_network %}
traefik.docker.network={{ thelounge_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if thelounge_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ thelounge_identifier }}-slashless-redirect.redirectregex.regex=^({{ thelounge_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ thelounge_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [thelounge_identifier + '-slashless-redirect'] %}
{% endif %}

{% if thelounge_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ thelounge_identifier }}-strip-prefix.stripprefix.prefixes={{ thelounge_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [thelounge_identifier + '-strip-prefix'] %}
{% endif %}

{% if thelounge_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in thelounge_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ thelounge_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [thelounge_identifier + '-add-request-headers'] %}
{% endif %}

{% if thelounge_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in thelounge_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ thelounge_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [thelounge_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ thelounge_identifier }}.rule={{ thelounge_container_labels_traefik_rule }}
{% if thelounge_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ thelounge_identifier }}.priority={{ thelounge_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ thelounge_identifier }}.service={{ thelounge_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ thelounge_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ thelounge_identifier }}.entrypoints={{ thelounge_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ thelounge_identifier }}.tls={{ thelounge_container_labels_traefik_tls | to_json }}
{% if thelounge_container_labels_traefik_tls %}
traefik.http.routers.{{ thelounge_identifier }}.tls.certResolver={{ thelounge_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ thelounge_identifier }}.loadbalancer.server.port={{ thelounge_container_http_port }}
{% endif %}

{% for arg in thelounge_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
